## @file
#  UEFI driver that intentionally triggers a #PF (Page-Fault) exception.
#
##

[Defines]
  INF_VERSION    = 0x00010006
  BASE_NAME      = PageFault
  FILE_GUID      = 6c1f9a4e-2b7d-4e85-9f3a-1d0c5e8b7a42
  MODULE_TYPE    = UEFI_DRIVER
  VERSION_STRING = 0.1
  ENTRY_POINT    = PageFaultEntryPoint

[Sources]
  PageFault.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiLib
  BaseLib

[Protocols]
  gEfiMemoryAttributeProtocolGuid

[BuildOptions]
  MSFT:*_*_*_CC_FLAGS = /GL-
